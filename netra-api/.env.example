# ─────────────────────────────────────────────────────────────────────────────
# N.E.T.R.A. API — Environment Variables
# Copy this file to .env and fill in your actual values.
# NEVER commit .env to version control.
# ─────────────────────────────────────────────────────────────────────────────

# MongoDB connection string
# Local:   mongodb://127.0.0.1:27017/netra
# Atlas:   mongodb+srv://<user>:<password>@cluster0.xxxxx.mongodb.net/netra?retryWrites=true&w=majority
MONGO_URI=mongodb://127.0.0.1:27017/netra

# Port the Express server will listen on
PORT=5000

# Allowed origins for CORS (comma-separated if multiple)
# e.g. http://localhost:5173,https://netra.yourdomain.com
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Optional: explicit Python interpreter used to run NETRA-AI/pipeline.py
# macOS/Linux example: /Users/you/Downloads/N.E.T.R.A.-master 2/NETRA-AI/.venv/bin/python3
# Windows example: C:\\path\\to\\N.E.T.R.A.-master 2\\NETRA-AI\\.venv\\Scripts\\python.exe
# PYTHON_PATH=

# ── External AI Service (required for Render / cloud deployments) ──────
# URL of the NETRA-AI FastAPI service (no trailing slash).
# When set, the API forwards uploads to this service instead of spawning
# a local Python process. Required when netra-api and netra-ai run on
# separate containers/servers (e.g., both on Render).
# AI_SERVICE_URL=https://netra-ai-xxxx.onrender.com

# Public origin of the API for constructing output URLs sent to clients.
# Defaults to auto-detection from request headers if not set.
# PUBLIC_API_ORIGIN=https://netra-api-xxxx.onrender.com

# Public origin override specifically for the AI service output URLs.
# Falls back to PUBLIC_API_ORIGIN if not set.
# AI_PUBLIC_ORIGIN=https://netra-ai-xxxx.onrender.com

# Timeout (ms) for the initial POST to the AI service (default: 60000).
# Increase if the AI service has long cold-start times.
# AI_SERVICE_REQUEST_TIMEOUT_MS=60000

# Maximum AI pipeline runtime (ms) before watchdog kills it (default: 1200000 = 20 min).
# AI_MAX_RUNTIME_MS=1200000
